{
  "manifest_version": 3,
  "name": "Head in the Clouds",
  "version": "1.0",
  "description": "A relaxing cloud break extension.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "index.html",
    "default_icon": "cloud.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["cloud.png"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
